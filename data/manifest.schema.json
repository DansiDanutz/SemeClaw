{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SemeClawReleaseManifest",
  "description": "Manifest served from R2 that the War Room checks for available updates.",
  "type": "object",
  "required": ["updates", "latest"],
  "properties": {
    "updates": {
      "type": "array",
      "description": "Chronological list of releases, newest first.",
      "items": {
        "type": "object",
        "required": ["version", "date", "image", "release_url"],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semver version string."
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 UTC timestamp of release."
          },
          "image": {
            "type": "string",
            "description": "Full Docker image URI (e.g. ghcr.io/owner/semeclaw:0.7.1)."
          },
          "release_url": {
            "type": "string",
            "format": "uri",
            "description": "GitHub release page URL."
          },
          "changelog": {
            "type": "string",
            "description": "Short release notes or link to CHANGELOG."
          }
        }
      }
    },
    "latest": {
      "type": ["string", "null"],
      "description": "Latest available version, or null if no releases."
    }
  }
}
