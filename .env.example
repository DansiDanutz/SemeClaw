# ═══════════════════════════════════════════════════════════════════════
# SemeClaw Agent — environment configuration
# Copy to .env and fill in what you need. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════════════

# ──── TTS (Tier 1) ──────────────────────────────────────────────────────
# ElevenLabs Flash v2.5 — primary voice engine. Falls back to edge-tts
# (free Microsoft neural voices) when unset.
ELEVENLABS_API_KEY=

# Optional: also honoured as an alternate env name for the same key
# XI_API_KEY=

# ──── LLM ───────────────────────────────────────────────────────────────
# OpenRouter — used by /api/meeting/redirect, /replan, /finalize for
# picking best agent + rewriting segments. Without it these endpoints
# return pass-through null responses.
OPENROUTER_API_KEY=

# ──── Agent identity + auth ─────────────────────────────────────────────
# Bearer token protecting write endpoints (pin/unpin/finalize/redirect/replan).
# Leave unset for open mode (useful for local dev). In prod set something strong.
SEMECLAW_API_KEY=

# Identifier surfaced in the /api/agent/manifest + logs.
SEMECLAW_TENANT_ID=default

# Public URL baked into embed.js + manifest (so iframes + webhooks resolve).
SEMECLAW_PUBLIC_URL=http://127.0.0.1:8765
# Comma-separated CIDRs whose X-Forwarded-For chain may be trusted for
# per-client rate limiting. Leave empty unless you operate the proxy.
SEMECLAW_TRUSTED_PROXY_CIDRS=

# ──── CORS + iframe embed ───────────────────────────────────────────────
# Comma-separated allowlist of origins. "*" opens to everyone.
# Prod example: https://nervix.ai,https://dashboard.paperclip.com
SEMECLAW_CORS_ORIGINS=*

# CSP frame-ancestors — who is allowed to iframe this agent.
# Prod example: https://nervix.ai https://*.paperclip.com
SEMECLAW_FRAME_ANCESTORS=*

# ──── Supabase (optional — for fleet telemetry) ─────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required when the advertiser UI/API is enabled; verifies Supabase HS256 access tokens.
SUPABASE_JWT_SECRET=

# ──── Paperclip bridge (optional) ───────────────────────────────────────
PAPERCLIP_API_URL=http://127.0.0.1:13100/api
PAPERCLIP_API_KEY=

# ──── Task ingest adapters (all optional — sync skips when unset) ───────
# SemeClaw pulls tasks from each configured source. Missing creds = skip.
PAPERCLIP_BASE_URL=
# PAPERCLIP_API_KEY (set above) is reused
MOLTICA_BASE_URL=
MOLTICA_API_KEY=
# Claude Code adapter has no creds — it scans ~/.claude/projects/*/tasks.json
# GPT adapter:
GPT_BASE_URL=https://api.openai.com/v1
GPT_API_KEY=

# Override the API base used by `semeclaw tasks ...` CLI (default 127.0.0.1:8765)
# SEMECLAW_API=https://semeclaw.fly.dev

# ──── Team / Fleet Supabase (for KPI tracking + agent health) ───────────────
# The "Moltbot/DansLab" Supabase project. Get from Supabase dashboard.
DLS_TEAM_SUPABASE_URL=
DLS_TEAM_SUPABASE_SERVICE_KEY=

# ──── LLM Providers (War Room multi-agent pipeline) ─────────────────────────
# Anthropic Claude — primary orchestration model
ANTHROPIC_API_KEY=

# Moonshot / Kimi — strategist agent
MOONSHOT_API_KEY=

# Z.ai / ZhiPu — architect + coder agent
ZAI_API_KEY=

# ──── Telegram (Sentinel alerts + human-in-loop interrupts) ─────────────────
# Preferred names for the current webhook + adapter paths:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Backward-compatible aliases used by the older polling bridge:
SEMECLAW_BOT_TOKEN=
SEMECLAW_ALLOWED_CHAT=

# ──── Redis (task streams, interrupts, KPI collection) ───────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ──── Sentinel (fleet health monitor) ────────────────────────────────────────
# Port for the Sentinel FastAPI service
SENTINEL_PORT=18790

# ──── Model Coordinator (circuit-breaker proxy) ──────────────────────────────
COORDINATOR_PORT=8996

# ──── Release Manifest (R2) ──────────────────────────────────────────────────
SEMECLAW_MANIFEST_URL=https://semeclaw-updates.1fc06dad3c7f42576be40fc6437f8fec.workers.dev/manifest.json
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=

# ──── NERVIX Platform ────────────────────────────────────────────────────────
NERVIX_PORT=8080
NERVIX_PUBLIC_URL=http://127.0.0.1:8080
NERVIX_JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AdClaw checkout price IDs
ADCLAW_PRICE_USD_25=
ADCLAW_PRICE_USD_50=
# Required for annual tiers; annual checkout never falls back to monthly prices.
ADCLAW_PRICE_USD_250=
ADCLAW_PRICE_USD_500=
# Optional legacy monthly fallback used only by monthly tiers.
STRIPE_PRICE_SUBSCRIPTION=

# ──── NERVIX Backend (for credit_sync) ────────────────────────────────────────
NERVIX_API_BASE=https://nervix.ai/api/v1
NERVIX_API_KEY=

# ──── STT: faster-whisper ───────────────────────────────────────────────
# Defaults: "small" on CPU, "large-v3-turbo" on GPU. Both produce
# production-quality transcripts. Set tiny/base only for demos.
WHISPER_MODEL=
# "cpu" (default) or "cuda" when a GPU is available.
WHISPER_DEVICE=
# int8 (CPU default), float16 (GPU default), or float32.
WHISPER_COMPUTE=

# ═══════════════════════════════════════════════════════════════════════
# v1.0 — multi-tenant, billing, webhooks, adapters
# ═══════════════════════════════════════════════════════════════════════

# Admin SPA / audit + DLQ replay bearer (defaults to SEMECLAW_API_KEY if unset).
SEMECLAW_ADMIN_KEY=

# Force the in-memory tasks store (handy for the open-source demo).
# Auto-on when DLS_TEAM_SUPABASE_* env vars are blank.
SEMECLAW_LOCAL_TASKS=

# ──── v1 Stripe metered billing ─────────────────────────────────────────
# Map each (meter, plan) tuple to a subscription-item id so the flush
# loop can call /usage_records on the correct meter.
STRIPE_PRICE_METER_MEETINGS=
STRIPE_PRICE_METER_TTS=
STRIPE_PRICE_METER_LLM=
# Example: STRIPE_SUB_ITEM_MEETINGS_PRO=si_1ABCD...
# STRIPE_SUB_ITEM_<KIND>_<PLAN> e.g. STRIPE_SUB_ITEM_TTS_CHARS_PRO

# ──── v1 Adapters ───────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

LINEAR_API_KEY=
LINEAR_LABEL=semeclaw
# JSON: {"in_progress":"<state-id>","needs_review":"<state-id>","done":"<state-id>"}
LINEAR_STATE_MAP_JSON=

NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_SELECT_PROPERTY=SemeClaw
NOTION_INGEST_VALUE=queued
NOTION_DONE_VALUE=done

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=
# JSON: {"in_progress":"21","done":"31",...}
JIRA_TRANSITION_MAP_JSON=

# v1 data dir override (default: data/v1).
SEMECLAW_V1_DATA_DIR=

# ── Digital Assistant (/assistant) ──────────────────────────────────
# Assistant identity + default reply language (ISO 639-1)
ASSISTANT_NAME=Seme
ASSISTANT_DEFAULT_LANG=en
# Optional extra knowledge folder of .md files (e.g. a synced Obsidian vault)
SEMECLAW_VAULT_DIR=
# Real outbound phone calls via Twilio (leave empty to disable /call)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
