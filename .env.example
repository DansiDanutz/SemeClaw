# ═══════════════════════════════════════════════════════════════════════
# SemeClaw Agent — environment configuration
# Copy to .env and fill in what you need. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════════════

# ──── TTS (Tier 1) ──────────────────────────────────────────────────────
# ElevenLabs Flash v2.5 — primary voice engine. Falls back to edge-tts
# (free Microsoft neural voices) when unset.
ELEVENLABS_API_KEY=

# Optional: also honoured as an alternate env name for the same key
# XI_API_KEY=

# ──── LLM ───────────────────────────────────────────────────────────────
# OpenRouter — used by /api/meeting/redirect, /replan, /finalize for
# picking best agent + rewriting segments. Without it these endpoints
# return pass-through null responses.
OPENROUTER_API_KEY=

# ──── Agent identity + auth ─────────────────────────────────────────────
# Bearer token protecting write endpoints (pin/unpin/finalize/redirect/replan).
# Leave unset for open mode (useful for local dev). In prod set something strong.
SEMECLAW_API_KEY=

# Identifier surfaced in the /api/agent/manifest + logs.
SEMECLAW_TENANT_ID=default

# Public URL baked into embed.js + manifest (so iframes + webhooks resolve).
SEMECLAW_PUBLIC_URL=http://127.0.0.1:8765

# ──── CORS + iframe embed ───────────────────────────────────────────────
# Comma-separated allowlist of origins. "*" opens to everyone.
# Prod example: https://nervix.ai,https://dashboard.paperclip.com
SEMECLAW_CORS_ORIGINS=*

# CSP frame-ancestors — who is allowed to iframe this agent.
# Prod example: https://nervix.ai https://*.paperclip.com
SEMECLAW_FRAME_ANCESTORS=*

# ──── Supabase (optional — for fleet telemetry) ─────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ──── Paperclip bridge (optional) ───────────────────────────────────────
PAPERCLIP_API_URL=http://127.0.0.1:13100/api
PAPERCLIP_API_KEY=

# ──── Team / Fleet Supabase (for KPI tracking + agent health) ───────────────
# The "Moltbot/DansLab" Supabase project. Get from Supabase dashboard.
DLS_TEAM_SUPABASE_URL=
DLS_TEAM_SUPABASE_SERVICE_KEY=

# ──── LLM Providers (War Room multi-agent pipeline) ─────────────────────────
# Anthropic Claude — primary orchestration model
ANTHROPIC_API_KEY=

# Moonshot / Kimi — strategist agent
MOONSHOT_API_KEY=

# Z.ai / ZhiPu — architect + coder agent
ZAI_API_KEY=

# ──── Telegram (Sentinel alerts + human-in-loop interrupts) ─────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ──── Redis (task streams, interrupts, KPI collection) ───────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ──── Sentinel (fleet health monitor) ────────────────────────────────────────
# Port for the Sentinel FastAPI service
SENTINEL_PORT=18790

# ──── Model Coordinator (circuit-breaker proxy) ──────────────────────────────
COORDINATOR_PORT=8996
