<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danslab.sentinel</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/davidai/SemeClaw/systemd/start_sentinel.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/davidai/SemeClaw</string>

    <key>StandardOutPath</key>
    <string>/Users/davidai/SemeClaw/logs/sentinel.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/davidai/SemeClaw/logs/sentinel.error.log</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
