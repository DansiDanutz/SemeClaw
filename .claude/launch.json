{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "war-room-dashboard",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "semeclaw", "war-room"],
      "port": 8765
    },
    {
      "name": "cloudflare-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--config", "cloudflare/worker/wrangler.toml"],
      "port": 8787
    },
    {
      "name": "website-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8000", "--directory", "website"],
      "port": 8000
    }
  ]
}
